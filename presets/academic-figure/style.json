{
  "name": "academic-figure",
  "mood": "Academic-talk style built around figures and tables. Careful captions and sources, minimal decoration. Fits research talks, paper presentations, and lab meetings",
  "canvas": {"ratio": "16:9", "margin": 0.5},
  "color": {"bg": "#FFFFFF", "ink": "#1B1B1B", "muted": "#5F6B73", "accent": "#00798C"},
  "font": {"head": "Noto Sans KR", "body": "Noto Sans KR"},
  "scale": {"head": 36, "title": 24, "governing": 18, "body": 16, "caption": 11, "mono": 13},
  "rhythm": {"line_height": 1.3, "tracking_head": -0.02, "tracking_body": -0.01},
  "cover": "band",
  "structure": "assertion",
  "layout": "figure",
  "motifs": ["Figure number and caption (Figure 1.)", "Always a source line", "Section number at top left"],
  "avoid": ["L1", "I1", "I4", "D6"],
  "source": "preset:academic-figure"
}
